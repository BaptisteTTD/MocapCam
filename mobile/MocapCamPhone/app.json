{
  "expo": {
    "name": "MocapCam",
    "slug": "mocapcam-phone",
    "version": "1.0.5",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mocapcam.phone",
      "infoPlist": {
        "NSCameraUsageDescription": "MocapCam filme l'acteur pour la capture de mouvement.",
        "NSMicrophoneUsageDescription": "Le son sert à synchroniser précisément les téléphones entre eux.",
        "NSLocalNetworkUsageDescription": "MocapCam se connecte à MocapCam Studio sur votre PC via le Wi-Fi.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoads": true
        },
        "UIRequiresFullScreen": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "6"
    },
    "android": {
      "package": "com.mocapcam.phone",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 6
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
